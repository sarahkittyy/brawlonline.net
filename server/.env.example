# Copy to server/.env (gitignored) for local development. The services, the
# admin CLI and mmclient read it from the current directory on startup.
# Production uses /etc/ppserver/*.env instead (see deploy/README.md).

# Postgres from docker-compose.yml.
DATABASE_URL=postgres://pp:pp-dev-password@127.0.0.1:54329/pp

# Shared by accounts and mm; play keys are derived from it. Generate with:
#   cargo run -p admin -- gen-secret
PLAY_KEY_SECRET=replace-with-64-hex-chars

# accounts
ACCOUNTS_LISTEN=127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
SIGNUP_INVITE_ONLY=true
REQUIRE_EMAIL_VERIFICATION=true
LATEST_VERSION=0.1.0

# Email. MAILER is resend | stdout | file. Leave RESEND_API_KEY empty in
# development: emails are then printed to stdout instead of sent.
MAILER=stdout
RESEND_API_KEY=
MAIL_FROM=noreply@fluffycat.gay
MAIL_FILE=mail.jsonl
MAIL_DAILY_LIMIT=90

# mm
MM_LISTEN=0.0.0.0:43113
MM_TICKET_TTL_SECS=600
# MM_MIN_APP_VERSION=0.1.0
# MM_RULESETS_FILE=config/rulesets.json

RUST_LOG=info,sqlx=warn
