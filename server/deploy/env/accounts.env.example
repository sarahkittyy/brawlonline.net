# /etc/ppserver/accounts.env  (chmod 0640, owned by root)
DATABASE_URL=postgres://pp_accounts:CHANGE_ME@127.0.0.1:5432/pp
PLAY_KEY_SECRET=CHANGE_ME_64_HEX_CHARS_SAME_AS_MM
ACCOUNTS_LISTEN=127.0.0.1:8080
PUBLIC_BASE_URL=https://brawlonline.net
TRUST_PROXY_HEADERS=true
REQUIRE_EMAIL_VERIFICATION=true
LATEST_VERSION=0.1.0
MAILER=resend
RESEND_API_KEY=CHANGE_ME
MAIL_FROM="Brawl Online <noreply@brawlonline.net>"
# Emails per UTC day: 2/3 for verification, 1/3 for password resets (server/README.md,
# "Rate limits"). Keep it under the provider's daily quota (Brevo free: 300).
MAIL_DAILY_LIMIT=90
# SMTP instead of Resend: MAILER=smtp and the provider's submission server
# (server/README.md, "Email providers"). Values below are examples.
# MAILER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# SMTP_TLS=starttls
# SMTP_TIMEOUT_SECS=15
# Brevo's HTTP API instead (MAILER=brevo): an API v3 key, not an SMTP key.
# MAILER=brevo
# BREVO_API_KEY=CHANGE_ME
RUST_LOG=info,sqlx=warn
