# /etc/ppserver/accounts.env  (root:ppserver 0640). Read by pp-accounts.service and pp-admin.
# The production file on sarahvps2, with the secrets replaced by CHANGE_ME.
# See server/deploy/PROD.md. Never commit the real file.
DATABASE_URL=postgres://pp_accounts:CHANGE_ME@127.0.0.1:5432/pp
# Must be identical in mm.env. Changing it invalidates every play key.
PLAY_KEY_SECRET=CHANGE_ME_64_HEX_CHARS_SAME_AS_MM
ACCOUNTS_LISTEN=127.0.0.1:43180
# Base of the links in emails (https://brawlonline.net/verify-email?token=...).
PUBLIC_BASE_URL=https://brawlonline.net
# nginx sits in front and appends the client address to X-Forwarded-For.
TRUST_PROXY_HEADERS=true
REQUIRE_EMAIL_VERIFICATION=true
LATEST_VERSION=0.1.0

# Email. accounts and `pp-admin user reset-password --send-email` both use these.
# Today emails are NOT sent: they are appended as JSON lines to MAIL_FILE, where
# verification and reset links can be read (sudo cat the file).
MAILER=file
MAIL_FILE=/var/log/ppserver/mail.jsonl
# Only used with MAILER=resend.
RESEND_API_KEY=
MAIL_FROM="Brawl Online <noreply@brawlonline.net>"
# Emails per UTC day: 2/3 for verification (sign-ups wait once that is used up), 1/3 for
# password resets (server/README.md, "Rate limits"). Brevo's free plan allows 300 a day;
# pp-admin's --send-email counts separately.
MAIL_DAILY_LIMIT=90

# To send real mail through an SMTP provider (PROD.md, "Switching the mail
# provider"): add the provider's DNS records for brawlonline.net first, then set
# MAILER=smtp, uncomment and fill in the lines below, and
# `sudo systemctl restart pp-accounts`. Example values; verify in the provider's docs.
#   Brevo     smtp-relay.brevo.com:587
#   SMTP2GO   mail.smtp2go.com:587
#   Mailjet   in-v3.mailjet.com:587
#   Postmark  smtp.postmarkapp.com:587
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# SMTP_TLS=starttls
# SMTP_TIMEOUT_SECS=15

# Or Brevo's HTTP API (MAILER=brevo, chosen 2026-10-08): an API v3 key
# (xkeysib-...), not an SMTP key. Brevo restricts the key to authorised IPs
# (this box). Add the key without echoing it: PROD.md, "Switching the mail provider".
# MAILER=brevo
# BREVO_API_KEY=CHANGE_ME

RUST_LOG=info,sqlx=warn

# Bug reports from the launcher's bug button: the logs zips go to bug-<id>.zip here
# (the default, "bug-reports" in the working directory, is this same folder; the unit's
# StateDirectory creates it). `pp-admin bug list` / `bug show <id>` print them.
# BUG_REPORTS_DIR=/var/lib/ppserver/bug-reports
# BUG_REPORT_MAX_LOGS_BYTES=33554432     # one zip, 32 MiB (nginx allows 40m on that path)
# BUG_REPORTS_MAX_TOTAL_BYTES=4294967296 # all zips together, 4 GiB; past it zips are refused (507)

# Racial slur filter for display names and connect codes (server/README.md, "Racial slurs"):
# a DeepInfra key turns it on (the brawlonline-bot's key on sarahvps). Also read by
# `pp-admin user slur-scan`.
# DEEPINFRA_API_KEY=CHANGE_ME
# SLUR_FILTER_MODELS=mistralai/Mistral-Small-3.2-24B-Instruct-2506   # comma list: all must say YES
