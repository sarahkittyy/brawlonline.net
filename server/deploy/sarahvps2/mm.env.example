# /etc/ppserver/mm.env  (root:ppserver 0640). Read by pp-mm.service.
# The production file on sarahvps2, with the secrets replaced by CHANGE_ME.
# pp_mm may only read users (play-key columns) and insert into mm_matches.
DATABASE_URL=postgres://pp_mm:CHANGE_ME@127.0.0.1:5432/pp
# Must be identical in accounts.env.
PLAY_KEY_SECRET=CHANGE_ME_64_HEX_CHARS_SAME_AS_ACCOUNTS
# Public UDP. Clients reach it as mm.brawlonline.net:43113
# (Cloudflare: A record 15.204.242.219, DNS only / grey cloud).
MM_LISTEN=0.0.0.0:43113
MM_TICKET_TTL_SECS=600
# A game older than its platform's newest build in the launcher's update feed may not play
# online (searches and room readies are refused with "Close Dolphin and update to ...").
MM_UPDATE_FEED_DIR=/var/www/brawlonline/updates/launcher
# MM_MIN_APP_VERSION=0.1.0
# LATEST_VERSION=0.1.0
# MM_RULESETS_FILE=/etc/ppserver/rulesets.json
# MM_REGIONS_FILE=/etc/ppserver/regions.json
# GeoIP database for the ping estimate of a pair (pp-geoip-update.timer keeps it current). A pair
# over the ping limit (100 ms, +40 every 10 s of waiting, none after 40 s) waits for someone closer.
MM_GEOIP_FILE=/var/lib/ppserver/geoip/dbip-city-lite.mmdb
# MM_PING_LIMIT_MS=100
# MM_REMATCH_HOLD_SECS=30
RUST_LOG=info,sqlx=warn
# Spectating's kill switch (docs/spectate-protocol.md §1): off (nothing uploaded or listed),
# witness (digests only, nothing listed) or on. On in production since 2026-10-14. Takes effect on
# a restart of pp-mm, which drops every online connection for a moment (they reconnect).
MM_SPECTATE=on
