# Caddy in front of the accounts service and the website (Brawl Online): the generic plan.
# Production on sarahvps2 uses nginx instead (deploy/sarahvps2/brawl-online.conf), with the
# same layout: brawlonline.net serves the static website (website/ in the repository, plus
# /downloads/ and the launcher feed /updates/launcher/) and proxies the accounts paths.
# The mm server (mm.brawlonline.net, UDP 43113) does not go through Caddy.
{
	email admin@fluffycat.gay
}

www.brawlonline.net {
	redir https://brawlonline.net{uri} permanent
}

brawlonline.net {
	encode zstd gzip
	# The API and the two email-link pages go to the accounts service.
	@accounts path /v1/* /user/* /verify-email /reset-password /healthz
	handle @accounts {
		reverse_proxy 127.0.0.1:8080
	}
	# Everything else is the static website.
	handle {
		root * /var/www/brawlonline
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	log {
		output file /var/log/caddy/brawlonline.log
		format json
	}
}
