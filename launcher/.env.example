# Copy to .env for development. Everything is optional.

# Accounts API (server/crates/accounts). Defaults to https://accounts.fluffycat.gay
# PPO_ACCOUNTS_URL=http://127.0.0.1:8080
# PPO_WEBSITE_URL=
# PPO_MM_HOST=
# PPO_UPDATES_URL=

# Dolphin build to launch when none is set in Settings. In development the default is
# ../dolphin/build/release/x64/Binaries/Dolphin.exe (next to this repository).
# PPO_DOLPHIN_PATH=
# Template User folder (P+ Launcher DOLs, Wii/sd.raw) copied into a new Dolphin User folder.
# Development default: ../run/template-user
# PPO_DOLPHIN_USER_TEMPLATE=

# Game asset cache. Development default: ./.asset-cache (gitignored)
# PPO_ASSET_CACHE=
# Read disc files from an extracted DATA/files folder instead of the ISO (development).
# Development default: ../game/rev1-extract/DATA/files if it exists
# PPO_DISC_FOLDER=

# MacOS signing
APPLE_API_ISSUER=example
APPLE_API_KEY=example # Path to a .p8 file
APPLE_API_KEY_ID=example
APPLE_TEAM_PROVIDER_ID=example
CSC_LINK=example
CSC_KEY_PASSWORD=example

# Debug variables

# If enabled, wraps translations strings with ~~ and logs i18next debug info
DEBUG_I18N= # Either 1 or 0.

# If enabled, logs out the SQL queries being executed by the replay database
DEBUG_REPLAY_DATABASE= # Either 1 or 0
